<?xml version="1.0" encoding="utf-8"?>
<!-- Original TRIfAma call screen layout. SPDX-License-Identifier: GPL-2.0-or-later -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calling_activity_top_viewgroup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/call_bg"
    tools:context="com.zoffcc.applications.trifa.CallingActivity">

    <com.zoffcc.applications.trifa.CustomVideoImageView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <ImageView
        android:id="@+id/caller_avatar_view"
        android:layout_width="176dp"
        android:layout_height="176dp"
        android:layout_gravity="center"
        android:background="@drawable/call_avatar_bg"
        android:contentDescription="@null"
        android:elevation="2dp"
        android:padding="32dp"
        android:scaleType="centerInside"
        android:src="@drawable/chat_ic_person" />

    <View
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/call_top_scrim" />

    <LinearLayout
        android:id="@+id/calling_friend_online_status"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:background="#2FBF71"
        android:elevation="6dp"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/top_text_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#F2F6F8"
            android:textSize="22sp"
            tools:text="Friend" />

        <TextView
            android:id="@+id/call_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9AA7B0"
            android:textSize="14sp"
            tools:text="Video call" />
    </LinearLayout>

    <ImageView
        android:id="@+id/audio_device_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="18dp"
        android:contentDescription="@null"
        android:elevation="6dp"
        android:src="@null" />

    <FrameLayout
        android:id="@+id/video_box_self_preview_01"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="16dp"
        android:background="@null"
        android:clickable="true"
        android:contentDescription="@string/call_toggle_self_preview"
        android:elevation="8dp"
        android:focusable="true"
        android:visibility="invisible">

        <com.zoffcc.applications.trifa.CameraSurfacePreview
            android:id="@+id/camera_surfaceview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.zoffcc.applications.trifa.CameraDrawingOverlay
            android:id="@+id/camera_drawing_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="1dp" />
    </FrameLayout>

    <!-- Legacy/debug controls remain available to the existing code but are not
         part of the default call surface. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/debug001"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <TextView
                android:id="@+id/debug001_text"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/video_box_left_top_01"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <TextView
                android:id="@+id/right_left_text_1"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/video_box_right_top_01"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <TextView
                android:id="@+id/right_top_text_1"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/right_top_text_1b"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/right_top_text_2"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/right_top_text_3"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/right_top_text_4"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/video_box_right_volumeslider_01"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <SeekBar
                android:id="@+id/volume_slider_seekbar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:max="100"
                android:progress="5" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/video_box_right_video_add_delay_slider_01"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <TextView
                android:id="@+id/video_add_delay_slider_infotext"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <SeekBar
                android:id="@+id/video_add_delay_slider_seekbar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:max="100"
                android:progress="5" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/video_box_aec"
            android:layout_width="0dp"
            android:layout_height="0dp">

            <Button
                android:id="@+id/video_box_aec_button"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/quality_slider_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/text_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_vq_low"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/text_vq_med"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/text_vq_high"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>

            <com.etiennelawlor.discreteslider.library.ui.DiscreteSlider
                android:id="@+id/quality_slider"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:backdropFillColor="#2FBF71"
                app:backdropStrokeColor="#0F1418"
                app:backdropStrokeWidth="2dp"
                app:horizontalBarThickness="4dp"
                app:position="0"
                app:tickMarkCount="3"
                app:tickMarkRadius="8dp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/call_audio_meters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="124dp"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="18dp"
                android:layout_height="116dp"
                android:background="@drawable/call_meter_bg"
                android:padding="4dp">

                <com.google.speech.levelmeter.BarLevelDrawable
                    android:id="@+id/audio_bar_in_v"
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />
            </FrameLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/call_audio_you"
                android:src="@drawable/call_ic_mic"
                android:tint="#9AA7B0" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="18dp"
                android:layout_height="116dp"
                android:background="@drawable/call_meter_bg"
                android:padding="4dp">

                <com.google.speech.levelmeter.BarLevelDrawable
                    android:id="@+id/audio_bar_out_v"
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />
            </FrameLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/call_audio_friend"
                android:src="@drawable/call_ic_speaker"
                android:tint="#9AA7B0" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/call_bottom_scrim"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:id="@+id/video_speaker_aec"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/video_box_speaker_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/call_btn_neutral"
                android:contentDescription="@string/call_speaker_off"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/call_ic_speaker" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/call_action_mute"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/mute_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/call_btn_neutral"
                android:contentDescription="@string/call_mute"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/call_ic_mic" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/call_action_camera"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/camera_toggle_button"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/call_btn_neutral"
                android:contentDescription="@string/call_switch_camera"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/call_ic_camera_switch" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/call_action_misc"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/misc_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/call_btn_neutral"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/chat_ic_more" />
        </FrameLayout>

        <TextView
            android:id="@+id/misc_button_pad"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/call_action_end"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/decline_button"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/call_btn_end"
                android:contentDescription="@string/call_end"
                android:keepScreenOn="true"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/call_ic_end" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/call_action_accept"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/accept_button"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/call_btn_accept"
                android:contentDescription="@string/call_accept"
                android:keepScreenOn="true"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/call_ic_accept" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
