<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/call_bg"
    tools:context="com.zoffcc.applications.trifa.CallingWaitingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:background="@drawable/call_avatar_bg"
            android:contentDescription="@null"
            android:padding="28dp"
            android:scaleType="centerInside"
            android:src="@drawable/chat_ic_person" />

        <TextView
            android:id="@+id/call_waiting_friend_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#F2F6F8"
            android:textSize="24sp"
            tools:text="Friend" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/call_waiting_title"
            android:textColor="#9AA7B0"
            android:textSize="16sp" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:indeterminate="true"
            android:indeterminateTint="#2FBF71" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/decline_waiting_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="@drawable/call_btn_end"
        android:contentDescription="@string/call_end"
        android:keepScreenOn="true"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/call_ic_end" />
</FrameLayout>
